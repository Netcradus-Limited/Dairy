rules_version = '2';

/// Sawariya Dairy — Complete Cloud Firestore Security Rules (Task 5)
/// ---------------------------------------------------------------------------
/// Architecture:
///   * Deny-by-default on all root documents.
///   * Authentication required for all private & operational data.
///   * Strict Role-Based Access Control (RBAC) backed by /users/{uid}.
///   * Roles: 'admin', 'delivery', 'customer'.
///   * Defense-in-depth: Field-level privilege escalation guards.
///   * fcmToken: Delivery agents may update their own token; admins have full access.
/// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deny by Default ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Shared RBAC Helpers ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnDoc(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Safely reads trusted user data from /users/{uid} with existence guard
    function getUserData() {
      return (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
          : null;
    }

    function currentRole() {
      let data = getUserData();
      if (data != null && ('role' in data) && data.role != null) {
        return data.role;
      }
      if (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) {
        let adminData = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
        return adminData != null && ('role' in adminData) ? adminData.role : null;
      }
      return null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        currentRole() in ['admin', 'superadmin', 'owner']
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaffMember() {
      return isSignedIn() && (
        currentRole() in ['admin', 'superadmin', 'owner', 'manager', 'dispatcher', 'staff']
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isStaffMember();
    }

    // Checks granular staff permission in users/{uid}.permissions or admins/{uid}.permissions
    function hasPermission(permKey) {
      let data = getUserData();
      let hasUserPerm = data != null && ('permissions' in data) && data.permissions is list && permKey in data.permissions;
      let hasAdminPerm = isSignedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && ('permissions' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
          && permKey in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions;

      return isSuperAdmin() || hasUserPerm || hasAdminPerm;
    }

    function canManageCatalog() {
      return isSuperAdmin()
          || hasPermission('createProduct')
          || hasPermission('editProduct')
          || hasPermission('deleteProduct')
          || hasPermission('createCategory')
          || hasPermission('editCategory')
          || hasPermission('deleteCategory')
          || (isSignedIn() && currentRole() in ['admin', 'superadmin', 'owner', 'manager']);
    }

    function isDelivery() {
      return isSignedIn() && currentRole() == 'delivery';
    }

    function isCustomer() {
      return isSignedIn() && (currentRole() == 'customer' || currentRole() == null);
    }

    // ── 1. users Collection ─────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read own profile; Staff/Admins can read all users
      allow read: if isAdmin() || isOwnDoc(userId);

      // Self-registration: Strictly allows creating 'customer' profile only,
      // OR pre-provisioned staff role if record exists in admins collection.
      // Super Admins can create any user profile with any role.
      allow create: if isSuperAdmin()
          || (isOwnDoc(userId)
              && request.resource.data.uid == request.auth.uid
              && (request.resource.data.role == 'customer'
                  || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                      && request.resource.data.role == get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role)));

      // Profile Update:
      // Super Admins and authorized staff managers can update user profile.
      // Owners can update own profile, but MUST NEVER mutate 'role', 'uid', 'isAdmin', 'permissions', or 'walletBalance'.
      // They are explicitly allowed to update their name, email, phone, profileImageUrl, fcmToken, fcmTokens, etc.
      allow update: if isSuperAdmin()
          || hasPermission('manageStaff')
          || hasPermission('editCustomer')
          || (isOwnDoc(userId)
              && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
              && (!('role' in request.resource.data) || (('role' in resource.data) && request.resource.data.role == resource.data.role))
              && (!('isAdmin' in request.resource.data) || (('isAdmin' in resource.data) && request.resource.data.isAdmin == resource.data.isAdmin))
              && (!('permissions' in request.resource.data) || (('permissions' in resource.data) && request.resource.data.permissions == resource.data.permissions))
              && (!('walletBalance' in request.resource.data) || (('walletBalance' in resource.data) && request.resource.data.walletBalance == resource.data.walletBalance)));

      // User deletion: Super Admin or authorized staff manager only
      allow delete: if isSuperAdmin() || hasPermission('manageStaff') || hasPermission('deleteCustomer');
    }

    // ── 2. users/{userId}/addresses Subcollection ───────────────────────────
    match /users/{userId}/addresses/{addressId} {
      // Owners can CRUD own addresses; Admins have full access
      allow read, create, update, delete: if isAdmin() || isOwnDoc(userId);
    }

    // ── 3. users/{userId}/notifications Subcollection ───────────────────────
    match /users/{userId}/notifications/{notifId} {
      // Owners read own notifications; Admins read all
      allow read: if isAdmin() || isOwnDoc(userId);

      // Only Admins / staff with sendNotifications can create/broadcast notifications
      allow create: if isSuperAdmin() || hasPermission('sendNotifications') || isAdmin();

      // Owners can only update 'isRead' status; Admins have full update access
      allow update: if isAdmin()
          || (isOwnDoc(userId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));

      // Owners can dismiss/delete own notifications; Admins have full delete access
      allow delete: if isAdmin() || isOwnDoc(userId);
    }

    // ── 4. users/{userId}/cart Subcollection ─────────────────────────────────
    match /users/{userId}/cart/{productId} {
      // Owners can CRUD own cart items; Admins have full access
      allow read, create, update, delete: if isAdmin() || isOwnDoc(userId);
    }

    // ── 5. users/{userId}/subscription Subcollection ────────────────────────
    match /users/{userId}/subscription/{subscriptionId} {
      // Owners can CRUD own subscriptions; Admins have full access
      allow read, create, update, delete: if isAdmin() || isOwnDoc(userId);
    }

    // ── 5a. users/{userId}/delivery_records Subcollection ────────────────────
    match /users/{userId}/delivery_records/{recordId} {
      // Owners can read own delivery records; Admins have full access
      allow read: if isAdmin() || isOwnDoc(userId);
      allow create, update, delete: if isAdmin();
    }

    // ── 5b. users/{userId}/skipped_dates Subcollection ───────────────────────
    match /users/{userId}/skipped_dates/{dateId} {
      // Owners and Admins can manage skipped delivery dates
      allow read, create, update, delete: if isAdmin() || isOwnDoc(userId);
    }

    // ── 5c. subscriptions Root Collection ────────────────────────────────────
    match /subscriptions/{subscriptionId} {
      // Customers read own subscriptions; Admins read all subscriptions
      allow read: if isAdmin() || hasPermission('viewSubscriptions')
          || (isCustomer() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));

      // Customer CREATE:
      // - authenticated customer
      // - request.resource.data.userId == request.auth.uid
      // Admins have full access
      allow create: if isSuperAdmin() || hasPermission('createSubscription') || isAdmin()
          || (isCustomer()
              && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid));

      // Customer UPDATE:
      // - existing resource.data.userId == request.auth.uid
      // - new request.resource.data.userId == request.auth.uid (customer can never change ownership)
      // Admins have full access
      allow update: if isSuperAdmin() || hasPermission('editSubscription') || isAdmin()
          || (isCustomer()
              && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid)
              && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid));

      // Subscriptions are retained for history; Admins or owners can delete
      allow delete: if isSuperAdmin() || hasPermission('cancelSubscription') || isAdmin()
          || (isCustomer() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
    }

    // ── 6. products Collection ──────────────────────────────────────────────
    match /products/{productId} {
      // Any signed-in user can browse products in the shop
      allow read: if isSignedIn();

      // Only authorized catalog managers can create, edit, or delete products
      allow create: if isSuperAdmin() || hasPermission('createProduct') || canManageCatalog();
      allow update: if isSuperAdmin() || hasPermission('editProduct') || canManageCatalog();
      allow delete: if isSuperAdmin() || hasPermission('deleteProduct') || canManageCatalog();
    }

    // ── 7. categories Collection ────────────────────────────────────────────
    match /categories/{categoryId} {
      // Any signed-in user can view categories
      allow read: if isSignedIn();

      // Only authorized catalog managers can manage product categories
      allow create: if isSuperAdmin() || hasPermission('createCategory') || canManageCatalog();
      allow update: if isSuperAdmin() || hasPermission('editCategory') || canManageCatalog();
      allow delete: if isSuperAdmin() || hasPermission('deleteCategory') || canManageCatalog();
    }

    // ── 8. orders Collection ────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customers: read own orders.
      // Delivery: read pending unassigned orders (to accept) or assigned orders.
      // Admins & staff: read all orders if authorized.
      allow read: if isSuperAdmin()
          || hasPermission('viewOrders')
          || isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid)
          || (isDelivery()
              && (isUnassignedPendingOrder()
                  || (('assignedAgentId' in resource.data)
                      && resource.data.assignedAgentId == request.auth.uid)));

      // Customers can create legitimate orders owned by themselves starting in 'Pending' state.
      allow create: if isSuperAdmin()
          || isAdmin()
          || (isSignedIn()
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.status in ['Pending', 'pending', 'placed']
              && !('assignedAgentId' in request.resource.data)
              && !('acceptedAt' in request.resource.data));

      // Order update:
      // Admins & staff: Full management based on permissions.
      // Customers: Can cancel their own pending/placed/confirmed orders before dispatch.
      // Delivery Agents: Controlled state transition and assignment operations.
      allow update: if isSuperAdmin()
          || hasPermission('editOrders')
          || hasPermission('assignDeliveryAgent')
          || hasPermission('cancelOrders')
          || isAdmin()
          || (isSignedIn() && canCustomerCancelOrder())
          || (isDelivery() && canUpdateAssignedOrder());

      // Only Super Admins or authorized staff may delete orders
      allow delete: if isSuperAdmin() || hasPermission('cancelOrders');
    }

    // Guard for checking pending unassigned orders that agents may browse
    function isUnassignedPendingOrder() {
      return resource.data.status in ['Pending', 'pending', 'placed']
          && (!('assignedAgentId' in resource.data)
              || resource.data.assignedAgentId == null
              || resource.data.assignedAgentId == '');
    }

    // Customer cancellation guard
    function canCustomerCancelOrder() {
      let isMine = resource.data.userId == request.auth.uid;
      let isCancellable = resource.data.status in ['Pending', 'pending', 'placed', 'Placed', 'confirmed', 'Confirmed', 'accepted', 'Accepted'];
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let setsCancelled = request.resource.data.status in ['cancelled', 'Cancelled'];

      return isMine
          && isCancellable
          && changed.hasOnly(['status', 'cancelledAt', 'cancellationReason', 'updatedAt'])
          && setsCancelled;
    }

    // Valid delivery status transition state machine
    function isValidDeliveryStatusTransition(fromStatus, toStatus) {
      let fromLower = (fromStatus is string) ? fromStatus.lower() : '';
      let toLower = (toStatus is string) ? toStatus.lower() : '';

      let isUnchanged = fromLower == toLower;
      let fromAccepted = (fromLower in ['accepted', 'confirmed'])
          && (toLower in ['accepted', 'confirmed', 'preparing', 'pickup', 'outfordelivery', 'out for delivery', 'cancelled']);
      let fromPreparing = (fromLower in ['preparing', 'pickup'])
          && (toLower in ['preparing', 'pickup', 'outfordelivery', 'out for delivery', 'cancelled']);
      let fromOutForDelivery = (fromLower in ['outfordelivery', 'out for delivery'])
          && (toLower in ['outfordelivery', 'out for delivery', 'delivered', 'cancelled']);

      return isUnchanged || fromAccepted || fromPreparing || fromOutForDelivery;
    }

    // Delivery-agent order mutation guard
    function canUpdateAssignedOrder() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let isMine = ('assignedAgentId' in resource.data)
          && resource.data.assignedAgentId == request.auth.uid;
      let isUnassigned = (!('assignedAgentId' in resource.data)
          || resource.data.assignedAgentId == null
          || resource.data.assignedAgentId == '')
          && (resource.data.status in ['Pending', 'pending', 'placed']);
      let claimsSelf = ('assignedAgentId' in request.resource.data)
          && request.resource.data.assignedAgentId == request.auth.uid
          && (request.resource.data.status.lower() in ['accepted', 'confirmed', 'preparing', 'pickup', 'outfordelivery', 'out for delivery']);
      let releases = ('assignedAgentId' in request.resource.data)
          && request.resource.data.assignedAgentId == null
          && (request.resource.data.status.lower() in ['pending', 'placed']);

      let isNonTerminal = !(resource.data.status.lower() in ['delivered', 'cancelled']);
      let validTransition = !('status' in request.resource.data)
          || isValidDeliveryStatusTransition(resource.data.status, request.resource.data.status);

      return isMine
          ? isNonTerminal && validTransition && (
              changed.hasOnly(['status', 'acceptedAt', 'deliveredAt', 'deliveryConfirmed', 'cancellationReason', 'updatedAt'])
              || (changed.hasOnly(['status', 'assignedAgentId', 'acceptedAt', 'updatedAt']) && releases)
            )
          : (isUnassigned
              ? changed.hasOnly(['status', 'assignedAgentId', 'acceptedAt', 'updatedAt']) && claimsSelf
              : false);
    }

    // ── 9. delivery_agents Collection ───────────────────────────────────────
    match /delivery_agents/{agentId} {
      // Delivery agent reads own profile; Customers track assigned driver for active order; Admins read all.
      // Delivery agents CANNOT read another agent's private profile.
      // Unrelated customers CANNOT read delivery agent profiles.
      allow read: if isAdmin()
          || (isDelivery() && isOwnDoc(agentId))
          || isCustomerOfActiveAgent();

      // Create own profile doc (Delivery agents or Admins)
      allow create: if isAdmin()
          || (isDelivery()
              && isOwnDoc(agentId)
              && request.resource.data.uid == request.auth.uid);

      // Update duty status, live GPS coordinates, vehicle information.
      // Agents can ONLY update their own profile and allowed fields.
      // Protected fields (rating, role, uid) CANNOT be mutated by agents.
      // Delivery agents may also update their fcmToken for push notification targeting.
      allow update: if isAdmin()
          || (isDelivery()
              && isOwnDoc(agentId)
              && isAllowedAgentUpdate());

      // Only Admins can delete delivery agent records
      allow delete: if isAdmin();
    }

    function isCustomerOfActiveAgent() {
      return isCustomer()
          && ('orderId' in resource.data)
          && resource.data.orderId != null
          && exists(/databases/$(database)/documents/orders/$(resource.data.orderId))
          && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid;
    }

    function isAllowedAgentUpdate() {
      let allowed = [
        'name',
        'phone',
        'email',
        'profileImageUrl',
        'vehicle',
        'vehicleType',
        'vehicleNumber',
        'assignedZone',
        'isOnline',
        'isOnDuty',
        'location',
        'orderId',
        'updatedAt',
        'fcmToken'
      ];
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let keepsUid = !('uid' in request.resource.data)
          || !('uid' in resource.data)
          || request.resource.data.uid == resource.data.uid;
      let keepsRole = !('role' in request.resource.data)
          || request.resource.data.role == 'delivery';

      return changed.hasOnly(allowed) && keepsUid && keepsRole;
    }

    // ── 10. earnings Collection ─────────────────────────────────────────────
    match /earnings/{earningId} {
      // Delivery agent reads own earnings; Admins read all.
      // Delivery agents can NEVER read other agents' earnings.
      allow read: if isAdmin()
          || (isDelivery() && resource.data.agentId == request.auth.uid);

      // Strictly written by Cloud Functions / Admin SDK only.
      // Delivery agents and customers cannot:
      //   - create arbitrary earnings
      //   - modify earning amount or tip
      //   - alter agentId or orderId
      //   - mutate another agent's earnings
      allow write: if isAdmin();
    }

    // ── 11. complaints Collection ───────────────────────────────────────────
    match /complaints/{complaintId} {
      // Customer reads own support tickets; Admins & authorized staff read all
      // Delivery users do NOT have access unless they are admins or viewing their own ticket
      allow read: if isSuperAdmin()
          || hasPermission('viewComplaints')
          || isAdmin()
          || (isSignedIn() && (
              resource.data.customerId == request.auth.uid
              || (('userId' in resource.data) && resource.data.userId == request.auth.uid)
             ));

      // Customers can file a support ticket owned by themselves in 'Open' / 'Pending' status
      // Cannot set adminReply upon creation
      allow create: if isSuperAdmin()
          || hasPermission('replyComplaint')
          || isAdmin()
          || (isSignedIn()
              && (
                  request.resource.data.customerId == request.auth.uid
                  || (('userId' in request.resource.data) && request.resource.data.userId == request.auth.uid)
                 )
              && request.resource.data.status in ['Open', 'open', 'Pending', 'pending']
              && (!('adminReply' in request.resource.data) || request.resource.data.adminReply == null || request.resource.data.adminReply == ''));

      // Only Admins / staff with replyComplaint can update ticket status, attach resolutions, or add admin replies
      allow update: if isSuperAdmin() || hasPermission('replyComplaint') || isAdmin();

      // Only Super Admins / authorized staff can delete complaints
      allow delete: if isSuperAdmin() || hasPermission('replyComplaint') || isSuperAdmin();
    }

    // ── 12. payments Collection ─────────────────────────────────────────────
    match /payments/{paymentId} {
      // Users read own payments; Admins read all payments
      allow read: if isSuperAdmin()
          || hasPermission('viewPayments')
          || isAdmin()
          || (isSignedIn() && (
              resource.data.userId == request.auth.uid
              || (('customerId' in resource.data) && resource.data.customerId == request.auth.uid)
             ));

      // Users can create a payment record corresponding to their own order during checkout
      allow create: if isSuperAdmin()
          || hasPermission('updatePaymentStatus')
          || isAdmin()
          || (isSignedIn() && (
              request.resource.data.userId == request.auth.uid
              || (('customerId' in request.resource.data) && request.resource.data.customerId == request.auth.uid)
             ));

      // Admins & staff with updatePaymentStatus have full management; Delivery agents can update status on cash collection for their assigned orders only
      allow update: if isSuperAdmin()
          || hasPermission('updatePaymentStatus')
          || isAdmin()
          || (isDelivery()
              && isPaymentAssignedToDeliveryAgent()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt']));

      // Only Super Admins / authorized staff can delete payment records
      allow delete: if isSuperAdmin() || hasPermission('updatePaymentStatus');
    }

    function isPaymentAssignedToDeliveryAgent() {
      let hasOrderId = ('orderId' in resource.data) && resource.data.orderId != null && resource.data.orderId != '';
      let orderDoc = hasOrderId && exists(/databases/$(database)/documents/orders/$(resource.data.orderId))
          ? get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data
          : null;
      return orderDoc != null
          && ('assignedAgentId' in orderDoc)
          && orderDoc.assignedAgentId == request.auth.uid;
    }

    // ── 13. admins Collection ───────────────────────────────────────────────
    match /admins/{adminId} {
      // Signed-in users can read admins collection for role verification / discovery
      allow read: if isSignedIn();
      // Super Admins or Staff Managers may create, update, or delete admin records
      allow write: if isSuperAdmin() || hasPermission('manageStaff');
    }

    // ── 14. delivery_batches Collection ────────────────────────────────────
    match /delivery_batches/{batchId} {
      // Admins & authorized staff have full access.
      // Delivery agents can read batches assigned to them.
      // Customers cannot access delivery batches.
      allow read: if isSuperAdmin()
          || hasPermission('viewDelivery')
          || isAdmin()
          || (isDelivery() && (
              resource.data.agentId == request.auth.uid
              || resource.data.staffName == request.auth.uid
             ));

      // Only Admins / staff with manageDelivery can create or delete delivery batches
      allow create, delete: if isSuperAdmin() || hasPermission('manageDelivery') || isAdmin();

      // Admins have full update; Assigned delivery agents can only update status/completedOrders/pendingOrders/updatedAt
      allow update: if isSuperAdmin()
          || hasPermission('manageDelivery')
          || isAdmin()
          || (isDelivery()
              && (
                  resource.data.agentId == request.auth.uid
                  || resource.data.staffName == request.auth.uid
                 )
              && (!('agentId' in request.resource.data) || request.resource.data.agentId == resource.data.agentId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedOrders', 'completedCount', 'pendingOrders', 'updatedAt']));
    }

    // ── 15. delivery_routes Collection ─────────────────────────────────────
    match /delivery_routes/{routeId} {
      // Admins & authorized staff have full access.
      // Delivery agents can read routes assigned to them.
      // Customers cannot access delivery routes.
      allow read: if isSuperAdmin()
          || hasPermission('viewDelivery')
          || isAdmin()
          || (isDelivery() && (
              resource.data.agentId == request.auth.uid
              || resource.data.riderName == request.auth.uid
             ));

      // Only Admins / staff with manageDelivery can create or delete delivery routes
      allow create, delete: if isSuperAdmin() || hasPermission('manageDelivery') || isAdmin();

      // Admins have full update; Assigned delivery agents can only update status/completedOrders/updatedAt
      allow update: if isSuperAdmin()
          || hasPermission('manageDelivery')
          || isAdmin()
          || (isDelivery()
              && (
                  resource.data.agentId == request.auth.uid
                  || resource.data.riderName == request.auth.uid
                 )
              && (!('agentId' in request.resource.data) || request.resource.data.agentId == resource.data.agentId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedOrders', 'updatedAt']));
    }
  }
}
